{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gcp-protocol.dev/schema/v0.1/enforcement-receipt.schema.json",
  "title": "GCP Enforcement Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["gcp_version", "receipt_id", "capsule_digest", "task_id", "runtime", "action", "resource", "decision", "controls", "timestamp", "freshness_evidence", "evidence", "proof"],
  "properties": {
    "gcp_version": {"$ref": "common.schema.json#/$defs/version"},
    "receipt_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "capsule_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "task_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "runtime": {"$ref": "common.schema.json#/$defs/identifier"},
    "action": {"type": "string", "minLength": 1, "maxLength": 128},
    "resource": {"$ref": "common.schema.json#/$defs/identifier"},
    "decision": {"$ref": "common.schema.json#/$defs/decision"},
    "controls": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "approval_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^GCP_[A-Z0-9_]+$"}},
    "timestamp": {"$ref": "common.schema.json#/$defs/timestamp"},
    "freshness_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "last_status_at"],
      "properties": {
        "profile": {"enum": ["online-strict", "bounded-stale", "offline-until-expiry"]},
        "last_status_at": {"$ref": "common.schema.json#/$defs/timestamp"},
        "status_digest": {"$ref": "common.schema.json#/$defs/digest"}
      }
    },
    "evidence": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/evidenceReference"}},
    "proof": {"$ref": "common.schema.json#/$defs/integrityProof"}
  },
  "allOf": [
    {"if": {"properties": {"decision": {"const": "APPROVAL_REQUIRED"}}}, "then": {"required": ["reason_codes"]}},
    {"if": {"properties": {"decision": {"const": "BLOCK"}}}, "then": {"required": ["reason_codes"]}}
  ]
}
