{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gcp-protocol.dev/schema/v0.1/approval.schema.json",
  "title": "GCP Approval v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["gcp_version", "approval_id", "approver", "capsule_digest", "scope", "issued_at", "expires_at", "max_uses", "evidence", "proof"],
  "properties": {
    "gcp_version": {"$ref": "common.schema.json#/$defs/version"},
    "approval_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "approver": {"$ref": "common.schema.json#/$defs/identifier"},
    "capsule_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "action", "resource"],
      "properties": {
        "type": {"enum": ["action", "amendment"]},
        "action": {"type": "string", "minLength": 1, "maxLength": 128},
        "resource": {"$ref": "common.schema.json#/$defs/identifier"},
        "change_digest": {"$ref": "common.schema.json#/$defs/digest"}
      },
      "allOf": [{"if": {"properties": {"type": {"const": "amendment"}}}, "then": {"required": ["change_digest"]}}]
    },
    "issued_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "expires_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "max_uses": {"type": "integer", "minimum": 1},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/evidenceReference"}},
    "proof": {"$ref": "common.schema.json#/$defs/integrityProof"}
  }
}
